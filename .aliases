#!/bin/sh

# aliases
alias ..='cd ..'
alias ...='cd ../../../'
alias ....='cd ../../../../'
alias df='df -h -x squashfs -x tmpfs -x devtmpfs'

# Platform differences
if [[ $(uname -s) == 'Darwin' ]]; then
    # macOS
    alias ls='ls -G'
    export CLICOLOR=1
else
    # Linux
    alias ls='ls --color=auto'
    # list IOMMU groups in an organised way
    alias ls-iommu='for d in /sys/kernel/iommu_groups/*/devices/*; do n=${d#*/iommu_groups/*}; n=${n%%/*}; printf "IOMMU Group %s " "$n"; lspci -nns "${d##*/}"; done;'
fi
# Common Aliases
alias ll='ls -lah'           # List all files, human readable sizes
alias la='ls -a'             # List all files
alias grep='grep --color=auto'
alias c='clear'
alias h='history'

## get top process eating memory
alias mem5='ps auxf | sort -nr -k 4 | head -5'
alias mem10='ps auxf | sort -nr -k 4 | head -10'

## get top process eating cpu ##
alias cpu5='ps auxf | sort -nr -k 3 | head -5'
alias cpu10='ps auxf | sort -nr -k 3 | head -10'

## List largest directories (aka "ducks")
alias dir5='du -cksh * | sort -hr | head -n 5'
alias dir10='du -cksh * | sort -hr | head -n 10'

alias publicip='curl ifconfig.me; echo'
alias reboot='shutdown -r now'
